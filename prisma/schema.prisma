generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum GymType {
  gym
  boxing
  mma
  muay_thai
  kickboxing
  martial_arts
}

enum LadiesStatus {
  mixed
  ladies_only
  ladies_timings
  men_only
}

enum SizeCategory {
  small
  medium
  large
}

enum BusinessCategory {
  gym
  fighting_club
}

enum ListingStatus {
  pending
  approved
  rejected
}

enum MembershipDuration {
  weekly
  monthly
  quarterly
  semi_annual
  yearly
}

model GymOwner {
  id               String           @id @default(cuid())
  email            String           @unique
  passwordHash     String
  name             String
  phone            String?
  businessCategory BusinessCategory
  isPremium        Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  gym              Gym?

  @@index([businessCategory])
}

model Gym {
  id             String       @id @default(cuid())
  name           String
  slug           String       @unique
  type             GymType
  customTypeLabel  String?
  description      String       @db.Text
  address        String
  area           String
  city           String
  latitude       Float?
  longitude      Float?
  priceMin       Int
  priceMax       Int
  ladiesStatus   LadiesStatus
  sizeCategory   SizeCategory
  whatsappNumber String
  openingHours   String?
  ladiesHours    String?
  rating         Float?
  featured       Boolean      @default(false)
  coachInfo          String?      @db.Text
  equipment          String?      @db.Text
  coverImage         String?
  coverImagePublicId String?
  listingStatus      ListingStatus @default(approved)
  ownerId            String?       @unique
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  owner         GymOwner?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  disciplines   GymDiscipline[]
  amenities     GymAmenity[]
  galleryImages    GymImage[]
  reviews          Review[]
  membershipPlans  MembershipPlan[]
  staffMembers     StaffMember[]

  @@index([city])
  @@index([area])
  @@index([type])
  @@index([priceMin, priceMax])
  @@index([featured])
  @@index([slug])
  @@index([listingStatus])
  @@index([ownerId])
}

model Discipline {
  id   String          @id @default(cuid())
  name String          @unique
  gyms GymDiscipline[]
}

model GymDiscipline {
  gymId        String
  disciplineId String
  gym          Gym        @relation(fields: [gymId], references: [id], onDelete: Cascade)
  discipline   Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)

  @@id([gymId, disciplineId])
}

model Amenity {
  id   String       @id @default(cuid())
  name String       @unique
  gyms GymAmenity[]
}

model GymAmenity {
  gymId     String
  amenityId String
  gym       Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([gymId, amenityId])
}

model GymImage {
  id       String  @id @default(cuid())
  gymId    String
  imageUrl String  @map("url")
  publicId String?
  alt      String?
  gym      Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
}

model Review {
  id        String   @id @default(cuid())
  gymId     String
  rating    Int
  text      String?  @db.Text
  author    String?
  createdAt DateTime @default(now())
  gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
}

model MembershipPlan {
  id          String             @id @default(cuid())
  gymId       String
  name        String
  description String?            @db.Text
  price       Int
  duration    MembershipDuration @default(monthly)
  features    String?            @db.Text
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  gym         Gym                @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([gymId, sortOrder])
}

model StaffMember {
  id              String   @id @default(cuid())
  gymId           String
  fullName        String
  designation     String
  bio             String?  @db.Text
  yearsExperience Int?
  specialization  String?
  certifications  String?  @db.Text
  achievements    String?  @db.Text
  profileImage    String?
  cloudinaryId    String?
  instagramUrl    String?
  facebookUrl     String?
  linkedinUrl     String?
  displayOrder    Int      @default(0)
  isCoach         Boolean  @default(true)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  gym             Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([gymId, displayOrder])
  @@index([gymId, isActive])
}
