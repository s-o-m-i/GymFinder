generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum GymType {
  gym
  boxing
  mma
  muay_thai
  kickboxing
  martial_arts
}

enum LadiesStatus {
  mixed
  ladies_only
  ladies_timings
  men_only
}

enum SizeCategory {
  small
  medium
  large
}

enum BusinessCategory {
  gym
  fighting_club
}

enum ListingStatus {
  pending
  approved
  rejected
}

enum MembershipDuration {
  weekly
  monthly
  quarterly
  semi_annual
  yearly
}

enum OwnerAuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum AnalyticsEventType {
  PROFILE_VIEW
  WHATSAPP_CLICK
  PHONE_CLICK
  DIRECTIONS_CLICK
}

enum TrainerAuthTokenType {
  EMAIL_OTP
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum TrainerLeadEventType {
  WHATSAPP_CLICK
  PHONE_CLICK
  CONTACT_CLICK
  PROFILE_VIEW
}

enum GymLeadGoal {
  WEIGHT_LOSS
  MUSCLE_GAIN
  MMA
  BOXING
  OTHER
}

enum FeatureRequestStatus {
  pending
  approved
  rejected
}

enum GymBranchStatus {
  ACTIVE
  TEMPORARILY_CLOSED
  PERMANENTLY_CLOSED
}

enum EventType {
  boxing
  mma
  muay_thai
  fitness
  crossfit
  sparring
  competition
  seminar
  other
}

model GymOwner {
  id               String           @id @default(cuid())
  email            String           @unique
  passwordHash     String
  name             String
  phone            String?
  businessCategory BusinessCategory
  isPremium        Boolean          @default(false)
  emailVerified    Boolean          @default(false)
  emailVerifiedAt  DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  gym              Gym?
  authTokens       OwnerAuthToken[]
  events           Event[]
  claimRequests    GymClaimRequest[]

  @@index([businessCategory])
  @@index([emailVerified])
}

model OwnerAuthToken {
  id        String             @id @default(cuid())
  ownerId   String
  tokenHash String             @unique
  type      OwnerAuthTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime           @default(now())
  owner     GymOwner           @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, type])
  @@index([expiresAt])
}

model Gym {
  id             String       @id @default(cuid())
  name           String
  slug           String       @unique
  type             GymType
  customTypeLabel  String?
  description      String       @db.Text
  address        String
  area           String
  city           String
  latitude       Float?
  longitude      Float?
  priceMin       Int
  priceMax       Int
  ladiesStatus   LadiesStatus
  sizeCategory   SizeCategory
  whatsappNumber String
  openingHours   String?
  ladiesHours    String?
  rating         Float?
  featured       Boolean      @default(false)
  featuredAt     DateTime?
  featuredUntil  DateTime?
  featuredPlan   String?
  coachInfo          String?      @db.Text
  equipment          String?      @db.Text
  transformations    String?      @db.Text
  coverImage         String?
  coverImagePublicId String?
  listingStatus      ListingStatus @default(approved)
  faqsEnabled        Boolean       @default(false)
  establishedYear    Int?
  memberCount        Int?
  ownerId            String?       @unique
  claimed            Boolean       @default(false)
  claimedAt          DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  owner         GymOwner?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  claimRequests GymClaimRequest[]
  disciplines   GymDiscipline[]
  amenities     GymAmenity[]
  galleryImages    GymImage[]
  reviews          Review[]
  membershipPlans  MembershipPlan[]
  staffMembers     StaffMember[]
  analyticsEvents  GymAnalyticsEvent[]
  trainers         Trainer[]
  events           Event[]
  faqs             GymFAQ[]
  featureRequests  FeatureRequest[]
  leads            GymLead[]
  publishedStories SuccessStory[] @relation("StoryPublisherGym")
  linkedStories    SuccessStory[] @relation("StoryLinkedGym")
  branches         GymBranch[]

  @@index([city])
  @@index([area])
  @@index([type])
  @@index([priceMin, priceMax])
  @@index([featured])
  @@index([featuredUntil])
  @@index([slug])
  @@index([listingStatus])
  @@index([ownerId])
}

model GymBranch {
  id             String          @id @default(cuid())
  gymId          String
  name           String
  slug           String
  description    String?         @db.Text
  address        String
  area           String
  city           String
  latitude       Float?
  longitude      Float?
  phone          String?
  whatsappNumber String?
  email          String?
  openingHours   String?
  ladiesHours    String?
  priceMin       Int?
  priceMax       Int?
  ladiesStatus   LadiesStatus?
  sizeCategory   SizeCategory?
  establishedYear Int?
  memberCount    Int?
  coachInfo      String?         @db.Text
  equipment      String?         @db.Text
  transformations String?        @db.Text
  coverImage     String?
  coverImagePublicId String?
  status         GymBranchStatus @default(ACTIVE)
  isPrimary      Boolean         @default(false)
  useCommonAmenities   Boolean   @default(true)
  useCommonDisciplines Boolean   @default(true)
  useCommonHours       Boolean   @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  gym            Gym                   @relation(fields: [gymId], references: [id], onDelete: Cascade)
  galleryImages  GymImage[]
  disciplines    GymBranchDiscipline[]
  amenities      GymBranchAmenity[]

  @@unique([gymId, slug])
  @@index([gymId])
  @@index([city])
  @@index([area])
  @@index([status])
  @@index([gymId, isPrimary])
  @@index([latitude, longitude])
}

model Discipline {
  id       String                  @id @default(cuid())
  name     String                  @unique
  gyms     GymDiscipline[]
  branches GymBranchDiscipline[]
}

model GymDiscipline {
  gymId        String
  disciplineId String
  gym          Gym        @relation(fields: [gymId], references: [id], onDelete: Cascade)
  discipline   Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)

  @@id([gymId, disciplineId])
}

model Amenity {
  id       String             @id @default(cuid())
  name     String             @unique
  gyms     GymAmenity[]
  branches GymBranchAmenity[]
}

model GymAmenity {
  gymId     String
  amenityId String
  gym       Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([gymId, amenityId])
}

model GymBranchDiscipline {
  gymBranchId  String
  disciplineId String
  gymBranch    GymBranch  @relation(fields: [gymBranchId], references: [id], onDelete: Cascade)
  discipline   Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)

  @@id([gymBranchId, disciplineId])
}

model GymBranchAmenity {
  gymBranchId String
  amenityId   String
  gymBranch   GymBranch @relation(fields: [gymBranchId], references: [id], onDelete: Cascade)
  amenity     Amenity   @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([gymBranchId, amenityId])
}

model GymImage {
  id       String     @id @default(cuid())
  gymId    String
  branchId String?
  imageUrl String     @map("url")
  publicId String?
  alt      String?
  gym      Gym        @relation(fields: [gymId], references: [id], onDelete: Cascade)
  branch   GymBranch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([branchId])
}

model Review {
  id        String   @id @default(cuid())
  gymId     String
  rating    Int
  text      String?  @db.Text
  author    String?
  createdAt DateTime @default(now())
  gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
}

model MembershipPlan {
  id          String             @id @default(cuid())
  gymId       String
  name        String
  description String?            @db.Text
  price       Int
  duration    MembershipDuration @default(monthly)
  features    String?            @db.Text
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  gym         Gym                @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([gymId, sortOrder])
}

model StaffMember {
  id              String   @id @default(cuid())
  gymId           String
  fullName        String
  designation     String
  bio             String?  @db.Text
  yearsExperience Int?
  specialization  String?
  certifications  String?  @db.Text
  achievements    String?  @db.Text
  profileImage    String?
  cloudinaryId    String?
  instagramUrl    String?
  facebookUrl     String?
  linkedinUrl     String?
  displayOrder    Int      @default(0)
  isCoach         Boolean  @default(true)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  gym             Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([gymId, displayOrder])
  @@index([gymId, isActive])
}

model GymFAQ {
  id           String   @id @default(cuid())
  gymId        String
  question     String
  answer       String   @db.Text
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  gym          Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([gymId, displayOrder])
  @@index([gymId, isActive])
}

model TrainerFAQ {
  id           String   @id @default(cuid())
  trainerId    String
  question     String
  answer       String   @db.Text
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  trainer      Trainer  @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId])
  @@index([trainerId, displayOrder])
  @@index([trainerId, isActive])
}

model GymAnalyticsEvent {
  id          String             @id @default(cuid())
  gymId       String
  eventType   AnalyticsEventType
  sessionId   String?
  visitorHash String?
  ipHash      String?
  userAgent   String?
  createdAt   DateTime           @default(now())
  gym         Gym                @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([eventType])
  @@index([createdAt])
  @@index([gymId, eventType, createdAt])
  @@index([gymId, eventType, visitorHash, createdAt])
}

model GymLead {
  id         String       @id @default(cuid())
  gymId      String
  name       String
  goal       GymLeadGoal
  customGoal String?
  sessionId  String?
  userAgent  String?      @db.Text
  createdAt  DateTime     @default(now())
  gym        Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId, createdAt])
  @@index([goal])
}

model TrainerAccount {
  id              String             @id @default(cuid())
  email           String             @unique
  passwordHash    String?
  name            String?
  phone           String?
  emailVerified   Boolean            @default(false)
  emailVerifiedAt DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  trainer         Trainer?
  authTokens      TrainerAuthToken[]

  @@index([emailVerified])
}

model TrainerAuthToken {
  id        String               @id @default(cuid())
  accountId String
  tokenHash String               @unique
  type      TrainerAuthTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime             @default(now())
  account   TrainerAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, type])
  @@index([expiresAt])
}

model Trainer {
  id              String   @id @default(cuid())
  accountId       String?  @unique

  fullName        String
  slug            String   @unique

  headline        String?
  bio             String?  @db.Text

  profileImage    String?
  cloudinaryId    String?

  city            String
  area            String?

  specialization  String?

  experienceYears Int?

  certifications  String?  @db.Text
  achievements    String?  @db.Text
  transformations String? @db.Text

  hourlyRate      Int?

  whatsappNumber  String?
  email           String?

  isVerified      Boolean  @default(false)
  isFeatured      Boolean  @default(false)
  isPublished     Boolean  @default(false)
  faqsEnabled     Boolean  @default(false)

  rating          Float?
  totalReviews    Int      @default(0)

  gender          String?
  availability    String?  @db.Text

  gymId           String?
  gym             Gym?     @relation(fields: [gymId], references: [id], onDelete: SetNull)
  account         TrainerAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  leadEvents      TrainerLeadEvent[]
  reviews         TrainerReview[]
  faqs            TrainerFAQ[]
  publishedStories SuccessStory[] @relation("StoryPublisherTrainer")
  linkedStories    SuccessStory[] @relation("StoryLinkedTrainer")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([city])
  @@index([specialization])
  @@index([isFeatured])
  @@index([isPublished])
  @@index([gymId])
  @@index([slug])
}

model TrainerLeadEvent {
  id          String               @id @default(cuid())
  trainerId   String
  eventType   TrainerLeadEventType
  sessionId   String?
  visitorHash String?
  ipHash      String?
  userAgent   String?
  createdAt   DateTime             @default(now())
  trainer     Trainer              @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId])
  @@index([eventType])
  @@index([createdAt])
  @@index([trainerId, eventType, createdAt])
  @@index([trainerId, eventType, visitorHash, createdAt])
}

model EventAnalyticsEvent {
  id          String   @id @default(cuid())
  eventId     String
  sessionId   String?
  visitorHash String?
  ipHash      String?
  userAgent   String?
  createdAt   DateTime @default(now())
  event       Event    @relation("EventAnalyticsEvents", fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([createdAt])
  @@index([eventId, visitorHash, createdAt])
}

model TrainerReview {
  id        String   @id @default(cuid())
  trainerId String
  rating    Int
  text      String?  @db.Text
  author    String?
  createdAt DateTime @default(now())
  trainer   Trainer  @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId])
}

model Event {
  id               String    @id @default(cuid())
  title            String
  slug             String    @unique
  description      String?   @db.Text
  type             EventType
  city             String
  area             String?
  address          String?
  startDate        DateTime
  endDate          DateTime?
  image            String?
  cloudinaryId     String?
  price            Int?
  isFeatured       Boolean   @default(false)
  gymId            String?
  createdByOwnerId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  gym             Gym?                  @relation(fields: [gymId], references: [id], onDelete: SetNull)
  createdByOwner  GymOwner?             @relation(fields: [createdByOwnerId], references: [id], onDelete: SetNull)
  analyticsEvents EventAnalyticsEvent[] @relation("EventAnalyticsEvents")

  @@index([city])
  @@index([type])
  @@index([gymId])
  @@index([startDate])
  @@index([slug])
  @@index([isFeatured])
}

model AiGymSearch {
  id            String   @id @default(cuid())

  // raw user input
  query         String

  // extracted structured filters from Gemini
  filtersJson   Json

  // number of gyms returned from Prisma
  resultsCount  Int

  // optional grouping for anonymous session tracking
  sessionId     String?

  // extracted or inferred city (important for analytics + SEO)
  city          String?

  // optional: helps detect repeated users (no auth needed)
  visitorHash   String?

  // optional: device + context (useful for optimization later)
  userAgent     String?

  // optional: track whether search returned useful results
  hadResults    Boolean  @default(true)

  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([city])
  @@index([sessionId])
  @@index([visitorHash])
}

model FeaturedPlan {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  durationDays Int
  amount       Int
  benefits     String[] @default([])
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  featureRequests FeatureRequest[]

  @@index([isActive, sortOrder])
}

model FeatureRequest {
  id                 String               @id @default(cuid())
  gymId              String
  planId             String?
  plan               String
  amount             Int
  paymentMethod      String
  transactionId      String?
  screenshotUrl      String?
  screenshotPublicId String?
  notes              String?
  status             FeatureRequestStatus @default(pending)
  reviewedAt         DateTime?
  reviewedBy         String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  gym          Gym           @relation(fields: [gymId], references: [id], onDelete: Cascade)
  featuredPlan FeaturedPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([gymId])
  @@index([status])
  @@index([createdAt])
}

enum SuccessStoryPublisherType {
  GYM
  TRAINER
  USER
}

enum SuccessStoryStatus {
  DRAFT
  PUBLISHED
}

enum SuccessStoryGoal {
  WEIGHT_LOSS
  MUSCLE_GAIN
  STRENGTH
  ENDURANCE
  BOXING
  MMA
  GENERAL_FITNESS
  OTHER
}

enum SuccessStoryGender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum WeightUnit {
  KG
  LBS
}

enum HeightUnit {
  CM
  FT
  IN
}

model CommunityUser {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  fullName        String
  emailVerified   Boolean  @default(false)
  emailVerifiedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  successStories  SuccessStory[]

  @@index([emailVerified])
}

model SuccessStory {
  id        String @id @default(cuid())
  slug      String @unique
  title     String
  clientName String
  gender    SuccessStoryGender?
  city      String
  goal      SuccessStoryGoal
  duration  String
  story     String @db.Text

  coverImageUrl      String?
  coverCloudinaryId  String?
  beforeImageUrl     String
  beforeCloudinaryId String?
  afterImageUrl      String
  afterCloudinaryId  String?
  progressImages     String? @db.Text

  startWeight   Float?
  currentWeight Float?
  height        Float?
  weightUnit    WeightUnit @default(KG)
  heightUnit    HeightUnit @default(CM)

  publisherType      SuccessStoryPublisherType
  publisherGymId     String?
  publisherTrainerId String?
  publisherUserId    String?

  linkedGymId     String?
  linkedTrainerId String?

  status      SuccessStoryStatus @default(DRAFT)
  isVerified  Boolean            @default(false)
  isFeatured  Boolean            @default(false)
  publishedAt DateTime?

  seoTitle       String?
  seoDescription String?
  ogImageUrl     String?

  viewCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  publisherGym     Gym?            @relation("StoryPublisherGym", fields: [publisherGymId], references: [id], onDelete: Cascade)
  publisherTrainer Trainer?        @relation("StoryPublisherTrainer", fields: [publisherTrainerId], references: [id], onDelete: Cascade)
  publisherUser    CommunityUser?  @relation(fields: [publisherUserId], references: [id], onDelete: Cascade)
  linkedGym        Gym?            @relation("StoryLinkedGym", fields: [linkedGymId], references: [id], onDelete: SetNull)
  linkedTrainer    Trainer?        @relation("StoryLinkedTrainer", fields: [linkedTrainerId], references: [id], onDelete: SetNull)

  @@index([slug])
  @@index([status])
  @@index([publisherType])
  @@index([publisherGymId])
  @@index([publisherTrainerId])
  @@index([publisherUserId])
  @@index([linkedGymId])
  @@index([linkedTrainerId])
  @@index([city])
  @@index([goal])
  @@index([isVerified])
  @@index([isFeatured])
  @@index([publishedAt])
  @@index([createdAt])
}

// ─── Gym Profile Claims ─────────────────────────────────────────────────────

enum GymClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum GymClaimPosition {
  OWNER
  MANAGER
  PARTNER
  MARKETING_MANAGER
  OTHER
}

model GymClaimRequest {
  id               String           @id @default(cuid())
  gymId            String
  /// Maps to spec claimantUserId — GymOwner id when logged in.
  claimantOwnerId  String?
  fullName         String
  email            String
  phone            String
  whatsapp         String
  position         GymClaimPosition
  instagramUrl     String?
  facebookUrl      String?
  message          String?          @db.Text
  status           GymClaimStatus   @default(PENDING)
  submittedAt      DateTime         @default(now())
  reviewedAt       DateTime?
  reviewedBy       String?
  adminNotes       String?          @db.Text
  rejectionReason  String?          @db.Text

  gym       Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  claimant  GymOwner? @relation(fields: [claimantOwnerId], references: [id], onDelete: SetNull)

  @@index([gymId])
  @@index([status])
  @@index([claimantOwnerId])
  @@index([submittedAt])
  @@index([email])
}

// ─── Platform Notifications ─────────────────────────────────────────────────

enum NotificationType {
  PROFILE_APPROVED
  PROFILE_REJECTED
  NEW_REVIEW
  NEW_INQUIRY
  NEW_EVENT_BOOKING
  SUCCESS_STORY_APPROVED
  SUCCESS_STORY_REJECTED
  FEATURED_ENABLED
  FEATURED_EXPIRED
  ADMIN_MESSAGE
  BLOG_PUBLISHED
  PASSWORD_CHANGED
  EMAIL_VERIFIED
  SYSTEM
  PROMOTION
  PROFILE_CLAIM_SUBMITTED
  PROFILE_CLAIM_APPROVED
  PROFILE_CLAIM_REJECTED
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum NotificationEntityType {
  GYM
  TRAINER
  SUCCESS_STORY
  EVENT
  BLOG
  USER
  SYSTEM
}

enum NotificationRecipientRole {
  OWNER
  TRAINER
  COMMUNITY
  ADMIN
}

model Notification {
  id              String                    @id @default(cuid())
  recipientUserId String
  recipientRole   NotificationRecipientRole
  senderUserId    String?
  senderRole      NotificationRecipientRole?
  type            NotificationType
  title           String
  message         String
  icon            String?
  image           String?
  actionUrl       String?
  entityType      NotificationEntityType?
  entityId        String?
  priority        NotificationPriority      @default(NORMAL)
  status          NotificationStatus        @default(UNREAD)
  readAt          DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([recipientUserId, recipientRole])
  @@index([recipientUserId, recipientRole, status])
  @@index([status])
  @@index([createdAt])
  @@index([type])
}

model NotificationPreference {
  id              String                    @id @default(cuid())
  recipientUserId String
  recipientRole   NotificationRecipientRole
  emailEnabled    Boolean                   @default(true)
  browserEnabled  Boolean                   @default(false)
  smsEnabled      Boolean                   @default(false)
  whatsappEnabled Boolean                   @default(false)
  inAppEnabled    Boolean                   @default(true)
  typeOverrides   Json?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@unique([recipientUserId, recipientRole])
}
