generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum GymType {
  gym
  boxing
  mma
  muay_thai
  kickboxing
  martial_arts
}

enum LadiesStatus {
  mixed
  ladies_only
  ladies_timings
  men_only
}

enum SizeCategory {
  small
  medium
  large
}

enum BusinessCategory {
  gym
  fighting_club
}

enum ListingStatus {
  pending
  approved
  rejected
}

enum MembershipDuration {
  weekly
  monthly
  quarterly
  semi_annual
  yearly
}

enum OwnerAuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum AnalyticsEventType {
  PROFILE_VIEW
  WHATSAPP_CLICK
  PHONE_CLICK
  DIRECTIONS_CLICK
}

enum TrainerAuthTokenType {
  EMAIL_OTP
}

enum TrainerLeadEventType {
  WHATSAPP_CLICK
  PHONE_CLICK
  CONTACT_CLICK
  PROFILE_VIEW
}

enum EventType {
  boxing
  mma
  muay_thai
  fitness
  crossfit
  sparring
  competition
  seminar
  other
}

model GymOwner {
  id               String           @id @default(cuid())
  email            String           @unique
  passwordHash     String
  name             String
  phone            String?
  businessCategory BusinessCategory
  isPremium        Boolean          @default(false)
  emailVerified    Boolean          @default(false)
  emailVerifiedAt  DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  gym              Gym?
  authTokens       OwnerAuthToken[]
  events           Event[]

  @@index([businessCategory])
  @@index([emailVerified])
}

model OwnerAuthToken {
  id        String             @id @default(cuid())
  ownerId   String
  tokenHash String             @unique
  type      OwnerAuthTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime           @default(now())
  owner     GymOwner           @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, type])
  @@index([expiresAt])
}

model Gym {
  id             String       @id @default(cuid())
  name           String
  slug           String       @unique
  type             GymType
  customTypeLabel  String?
  description      String       @db.Text
  address        String
  area           String
  city           String
  latitude       Float?
  longitude      Float?
  priceMin       Int
  priceMax       Int
  ladiesStatus   LadiesStatus
  sizeCategory   SizeCategory
  whatsappNumber String
  openingHours   String?
  ladiesHours    String?
  rating         Float?
  featured       Boolean      @default(false)
  coachInfo          String?      @db.Text
  equipment          String?      @db.Text
  coverImage         String?
  coverImagePublicId String?
  listingStatus      ListingStatus @default(approved)
  faqsEnabled        Boolean       @default(false)
  ownerId            String?       @unique
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  owner         GymOwner?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  disciplines   GymDiscipline[]
  amenities     GymAmenity[]
  galleryImages    GymImage[]
  reviews          Review[]
  membershipPlans  MembershipPlan[]
  staffMembers     StaffMember[]
  analyticsEvents  GymAnalyticsEvent[]
  trainers         Trainer[]
  events           Event[]
  faqs             GymFAQ[]

  @@index([city])
  @@index([area])
  @@index([type])
  @@index([priceMin, priceMax])
  @@index([featured])
  @@index([slug])
  @@index([listingStatus])
  @@index([ownerId])
}

model Discipline {
  id   String          @id @default(cuid())
  name String          @unique
  gyms GymDiscipline[]
}

model GymDiscipline {
  gymId        String
  disciplineId String
  gym          Gym        @relation(fields: [gymId], references: [id], onDelete: Cascade)
  discipline   Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)

  @@id([gymId, disciplineId])
}

model Amenity {
  id   String       @id @default(cuid())
  name String       @unique
  gyms GymAmenity[]
}

model GymAmenity {
  gymId     String
  amenityId String
  gym       Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([gymId, amenityId])
}

model GymImage {
  id       String  @id @default(cuid())
  gymId    String
  imageUrl String  @map("url")
  publicId String?
  alt      String?
  gym      Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
}

model Review {
  id        String   @id @default(cuid())
  gymId     String
  rating    Int
  text      String?  @db.Text
  author    String?
  createdAt DateTime @default(now())
  gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
}

model MembershipPlan {
  id          String             @id @default(cuid())
  gymId       String
  name        String
  description String?            @db.Text
  price       Int
  duration    MembershipDuration @default(monthly)
  features    String?            @db.Text
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  gym         Gym                @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([gymId, sortOrder])
}

model StaffMember {
  id              String   @id @default(cuid())
  gymId           String
  fullName        String
  designation     String
  bio             String?  @db.Text
  yearsExperience Int?
  specialization  String?
  certifications  String?  @db.Text
  achievements    String?  @db.Text
  profileImage    String?
  cloudinaryId    String?
  instagramUrl    String?
  facebookUrl     String?
  linkedinUrl     String?
  displayOrder    Int      @default(0)
  isCoach         Boolean  @default(true)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  gym             Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([gymId, displayOrder])
  @@index([gymId, isActive])
}

model GymFAQ {
  id           String   @id @default(cuid())
  gymId        String
  question     String
  answer       String   @db.Text
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  gym          Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([gymId, displayOrder])
  @@index([gymId, isActive])
}

model TrainerFAQ {
  id           String   @id @default(cuid())
  trainerId    String
  question     String
  answer       String   @db.Text
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  trainer      Trainer  @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId])
  @@index([trainerId, displayOrder])
  @@index([trainerId, isActive])
}

model GymAnalyticsEvent {
  id          String             @id @default(cuid())
  gymId       String
  eventType   AnalyticsEventType
  sessionId   String?
  visitorHash String?
  ipHash      String?
  userAgent   String?
  createdAt   DateTime           @default(now())
  gym         Gym                @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([eventType])
  @@index([createdAt])
  @@index([gymId, eventType, createdAt])
  @@index([gymId, eventType, visitorHash, createdAt])
}

model TrainerAccount {
  id            String             @id @default(cuid())
  email         String             @unique
  emailVerified Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  trainer       Trainer?
  authTokens    TrainerAuthToken[]

  @@index([emailVerified])
}

model TrainerAuthToken {
  id        String               @id @default(cuid())
  accountId String
  tokenHash String               @unique
  type      TrainerAuthTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime             @default(now())
  account   TrainerAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, type])
  @@index([expiresAt])
}

model Trainer {
  id              String   @id @default(cuid())
  accountId       String?  @unique

  fullName        String
  slug            String   @unique

  headline        String?
  bio             String?  @db.Text

  profileImage    String?
  cloudinaryId    String?

  city            String
  area            String?

  specialization  String?

  experienceYears Int?

  certifications  String?  @db.Text
  achievements    String?  @db.Text

  hourlyRate      Int?

  whatsappNumber  String?
  email           String?

  isVerified      Boolean  @default(false)
  isFeatured      Boolean  @default(false)
  isPublished     Boolean  @default(false)
  faqsEnabled     Boolean  @default(false)

  rating          Float?
  totalReviews    Int      @default(0)

  gender          String?
  availability    String?  @db.Text

  gymId           String?
  gym             Gym?     @relation(fields: [gymId], references: [id], onDelete: SetNull)
  account         TrainerAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  leadEvents      TrainerLeadEvent[]
  reviews         TrainerReview[]
  faqs            TrainerFAQ[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([city])
  @@index([specialization])
  @@index([isFeatured])
  @@index([isPublished])
  @@index([gymId])
  @@index([slug])
}

model TrainerLeadEvent {
  id          String               @id @default(cuid())
  trainerId   String
  eventType   TrainerLeadEventType
  sessionId   String?
  visitorHash String?
  ipHash      String?
  userAgent   String?
  createdAt   DateTime             @default(now())
  trainer     Trainer              @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId])
  @@index([eventType])
  @@index([createdAt])
  @@index([trainerId, eventType, createdAt])
  @@index([trainerId, eventType, visitorHash, createdAt])
}

model EventAnalyticsEvent {
  id          String   @id @default(cuid())
  eventId     String
  sessionId   String?
  visitorHash String?
  ipHash      String?
  userAgent   String?
  createdAt   DateTime @default(now())
  event       Event    @relation("EventAnalyticsEvents", fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([createdAt])
  @@index([eventId, visitorHash, createdAt])
}

model TrainerReview {
  id        String   @id @default(cuid())
  trainerId String
  rating    Int
  text      String?  @db.Text
  author    String?
  createdAt DateTime @default(now())
  trainer   Trainer  @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId])
}

model Event {
  id               String    @id @default(cuid())
  title            String
  slug             String    @unique
  description      String?   @db.Text
  type             EventType
  city             String
  area             String?
  address          String?
  startDate        DateTime
  endDate          DateTime?
  image            String?
  cloudinaryId     String?
  price            Int?
  isFeatured       Boolean   @default(false)
  gymId            String?
  createdByOwnerId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  gym             Gym?                  @relation(fields: [gymId], references: [id], onDelete: SetNull)
  createdByOwner  GymOwner?             @relation(fields: [createdByOwnerId], references: [id], onDelete: SetNull)
  analyticsEvents EventAnalyticsEvent[] @relation("EventAnalyticsEvents")

  @@index([city])
  @@index([type])
  @@index([gymId])
  @@index([startDate])
  @@index([slug])
  @@index([isFeatured])
}

model AiGymSearch {
  id            String   @id @default(cuid())

  // raw user input
  query         String

  // extracted structured filters from Gemini
  filtersJson   Json

  // number of gyms returned from Prisma
  resultsCount  Int

  // optional grouping for anonymous session tracking
  sessionId     String?

  // extracted or inferred city (important for analytics + SEO)
  city          String?

  // optional: helps detect repeated users (no auth needed)
  visitorHash   String?

  // optional: device + context (useful for optimization later)
  userAgent     String?

  // optional: track whether search returned useful results
  hadResults    Boolean  @default(true)

  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([city])
  @@index([sessionId])
  @@index([visitorHash])
}
